    {
        "id": "30ba7e900b481cc1",
        "type": "function",
        "z": "3f19d769c907b38d",
        "name": "function 1",
        "func": "let d = msg.payload;\n\nif (d.temperatura === undefined || d.humedad === undefined) {\n    node.warn(\"Datos incompletos\");\n    return null;\n}\n\nlet estado_temp = (d.temperatura < 35) ? \"baja\" : (d.temperatura <= 15) ? \"adecuada\" : \"alta\";\nlet estado_hum = (d.humedad < 20) ? \"adecuada\" : \"exceso\";\nlet estado_luz = (d.luz1 == 0) ? \"adecuada\" : \"exceso\";\n\nlet alertas = [];\nif (estado_temp === \"alta\") alertas.push(\"Temperatura alta\");\nif (estado_hum === \"exceso\") alertas.push(\"Humedad alta\");\nif (estado_luz === \"exceso\") alertas.push(\"Exceso de luz\");\n\nmsg.payload = {\n    device: d.device || \"ESP8266\",\n    temperatura: d.temperatura,\n    humedad: d.humedad,\n    luz1: d.luz1,\n    estado_temp,\n    estado_hum,\n    estado_luz,\n    alertas,\n    fecha: new Date()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 380,
        "wires": [
