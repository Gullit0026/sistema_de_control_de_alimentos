    {
        "id": "86e92ef81b27359e",
        "type": "function",
        "z": "3f19d769c907b38d",
        "name": "Preparar dashboard",
        "func": "let d = msg.payload;\n\nlet cap = s => s ? s.charAt(0).toUpperCase() + s.slice(1) : '';\n\nlet msgTempChart = { payload: d.temperatura, topic: \"Temperatura\" };\nlet msgTempGauge = { payload: d.temperatura };\nlet msgHumChart  = { payload: d.humedad,     topic: \"Humedad\" };\nlet msgHumGauge  = { payload: d.humedad };\nlet msgLuz       = { payload: cap(d.estado_luz) };\nlet msgAlertas   = { payload: (d.alertas && d.alertas.length > 0) ? d.alertas.join(' | ') : 'Sin alertas' };\n\nreturn [ msgTempChart, msgTempGauge, msgHumChart, msgHumGauge, msgLuz, msgAlertas ];",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
